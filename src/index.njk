---
layout: base.njk
title: Home
bodyClass: home
scripts:
  - /assets/js/home.js
---
{% from "macros.njk" import publication %}
<div class="wrap">
  <section class="hero">
    <div>
      <h1>{{ site.title }}</h1>
      <p class="lede">{{ site.role }} {{ site.tagline }}</p>
      <p class="currently"><strong>Currently:</strong> {{ site.currently }}</p>
      <ul class="links">
        {%- for link in site.links %}
        <li><a href="{{ link.href }}">{{ link.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <figure style="margin:0">
      <div class="volume" id="lung-volume" role="img" aria-label="Illustration: a translucent volume containing voxelized lungs, with a predicted segmentation mask in the right upper lobe.">
        <svg class="placeholder" viewBox="0 0 100 100" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="0.35">
          <line x1="38.7" y1="58.4" x2="12.6" y2="74.9"/><line x1="38.7" y1="58.4" x2="37.9" y2="13.0"/><line x1="38.7" y1="58.4" x2="82.6" y2="64.8"/><line x1="12.6" y1="74.9" x2="9.2" y2="17.8"/><line x1="12.6" y1="74.9" x2="66.2" y2="85.5"/><line x1="37.9" y1="13.0" x2="9.2" y2="17.8"/><line x1="37.9" y1="13.0" x2="85.2" y2="14.8"/><line x1="9.2" y1="17.8" x2="67.9" y2="21.0"/><line x1="82.6" y1="64.8" x2="66.2" y2="85.5"/><line x1="82.6" y1="64.8" x2="85.2" y2="14.8"/><line x1="66.2" y1="85.5" x2="67.9" y2="21.0"/><line x1="85.2" y1="14.8" x2="67.9" y2="21.0"/>
        </svg>
      </div>
      <figcaption class="volume-caption">A predicted mask (red) in the right upper lobe. Drag or use the arrow keys to rotate.</figcaption>
    </figure>
  </section>

  <section class="section" aria-labelledby="pubs-title">
    <div class="section-head">
      <h2 id="pubs-title">Selected publications</h2>
      <a href="/publications/">All publications</a>
    </div>
    <ul class="pubs">
      {%- for p in publications | selectattr("selected") %}
      {{ publication(p) }}
      {%- endfor %}
    </ul>
  </section>

  <section class="section" aria-labelledby="notes-title">
    <div class="section-head">
      <h2 id="notes-title">From my notes</h2>
      <a href="/notes/">All notes</a>
    </div>
    <p class="prose" style="color:var(--ink-2)">Study notes from my courses, with interactive figures you can play with.</p>
    <ul class="cards">
      {%- for note in collections.notes %}{% if loop.index <= 3 %}
      <li class="card">
        <h3><a href="{{ note.url }}">{{ note.data.title }}</a></h3>
        <p>{{ note.data.description }}</p>
        <p class="meta">{{ note.data.course }} · {{ note.data.module }}</p>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </section>
</div>
