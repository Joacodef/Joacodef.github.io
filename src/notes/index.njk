---
layout: base.njk
title: Notes
description: Study notes from my courses, with interactive figures.
permalink: /notes/
---
{%- from "macros.njk" import langSwitch -%}
{%- set other = page.url | otherLanguage(collections.all) -%}
<div class="wrap">
  <header class="page-head">
    <h1>Notes</h1>
    <p>Study notes from my courses, with interactive figures you can play with.</p>
    {%- if other %}
    <p class="page-lang">{{ langSwitch(other, "en") }}</p>
    {%- endif %}
  </header>

  {#- Courses in the order set by `courseOrder` in each course folder's JSON file. #}
  {%- for course in collections.notes | courses %}
  <section class="section" aria-labelledby="c-{{ loop.index }}">
    <div class="section-head"><h2 id="c-{{ loop.index }}">{{ course }}</h2></div>
    {#- The notes of a course are read in order, so they are numbered. #}
    <ol class="cards" role="list">
      {%- for note in collections.notes | byCourse(course) %}
      <li class="card">
        <h3><span class="n">{{ loop.index }}</span><a href="{{ note.url }}">{{ note.data.title }}</a></h3>
        <p>{{ note.data.description }}</p>
        <p class="meta">{{ note.data.module }}</p>
      </li>
      {%- endfor %}
    </ol>
  </section>
  {%- endfor %}

  <p class="notice">These are personal study notes, written with AI assistance. They may contain errors.</p>
</div>
